m <- rbn2(1000, p = 50, nei = 5)
G <- m$G
x <- m$x
a1 <- omp.network(x, method = "BIC", tol = 2)
a2 <- omp.network(x, method = "BIC", tol = 4)
skel=a1
p <- length(skel$Rho)
G <- matrix(0, p, p)
colnames(G) <- rownames(G) <- colnames(skel$G)
a <- skel$Rho[[ i ]]
i=1
a
a1$Rho[[i]]
a2$Rho[[i]]
a <- skel$Rho[[ i ]]
id <- abs( dif(a) ) > tol
tol=4
id <- abs( diff(a) ) > tol
id
